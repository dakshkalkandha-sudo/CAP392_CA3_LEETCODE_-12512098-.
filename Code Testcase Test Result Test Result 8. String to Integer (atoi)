
class Solution {
public:
    int myAtoi(string s) {
        int i = 0;
        int n = s.length();
        int sign = 1;
        long long result = 0;

        // Ignore leading spaces
        while (i < n && s[i] == ' ') {
            i++;
        }

        // Check sign
        if (i < n && (s[i] == '+' || s[i] == '-')) {
            if (s[i] == '-') {
                sign = -1;
            }
            i++;
        }

        // Convert digits
        while (i < n && s[i] >= '0' && s[i] <= '9') {
            result = result * 10 + (s[i] - '0');

            if (result * sign > INT_MAX) {
                return INT_MAX;
            }

            if (result * sign < INT_MIN) {
                return INT_MIN;
            }

            i++;
        }

        return (int)(result * sign);
    }
};
